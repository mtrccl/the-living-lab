{
  "name": "the-living-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:runner",
    "test": "vitest run",
    "build:runner": "esbuild src/persistence.ts --bundle --platform=node --format=esm --target=node20 --outfile=runner/world-engine.mjs",
    "start:runner": "node runner/runner.mjs",
    "test:runner": "node --test runner/runner.test.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
